# Copy to .env. Never commit real credentials.
# Named local credentials. Login URL and element locators belong to each flow.
# Use different non-secret aliases for each account; never put passwords in chat.
CREDENTIALS_JSON='{"demo_local":{"origin":"http://127.0.0.1:8000","username":"operator","password":"demo-password"}}'
LOADING_SELECTOR=#loading
RESULT_SELECTOR=#results

# OpenAI-compatible Chat Completions endpoint, including /v1 if required.
# The provider and model MUST support tool calling.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MODEL_TIMEOUT_S=60
MAX_TOOL_ACTIONS=8

# Headless avoids opening another window; the live view is in the app.
HEADLESS=false
# Optional absolute path; default is <repo>/downloads.
# DOWNLOAD_DIR=E:/agent-exports
ACTION_TIMEOUT_MS=30000
QUERY_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=60000
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Optional absolute SQLite path; default is <repo>/data/agent-v2.sqlite3.
# DATABASE_PATH=E:/agent-data/agent-v2.sqlite3
