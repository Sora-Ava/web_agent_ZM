# Copy to .env. Never commit real credentials.
SITE_URL=http://127.0.0.1:8000/demo/login
SITE_USERNAME=demo
SITE_PASSWORD=demo-password
LOGIN_USERNAME_SELECTOR=#username
LOGIN_PASSWORD_SELECTOR=#password
LOGIN_SUBMIT_SELECTOR=#login
LOGGED_IN_SELECTOR=#logged-in
LOADING_SELECTOR=#loading
RESULT_SELECTOR=#results

# OpenAI-compatible Chat Completions endpoint, including /v1 if required.
# The provider and model MUST support tool calling.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MODEL_TIMEOUT_S=60
MAX_TOOL_ACTIONS=8

# Headless avoids opening another window; the live view is in the app.
HEADLESS=true
# Optional absolute path; default is <repo>/downloads.
# DOWNLOAD_DIR=E:/agent-exports
ACTION_TIMEOUT_MS=30000
QUERY_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=60000
FRONTEND_ORIGIN=http://127.0.0.1:5173
